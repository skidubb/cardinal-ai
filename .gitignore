# Python
__pycache__/
*.py[cod]
venv/
venv_*/
.venv/
*.egg-info/

# Environment
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Firebase
firebase-debug.log

# IDE
.vscode/
.idea/

# Claude Code — local-only state is ignored; the shared harness surface
# (settings.json, skills/, agents/, commands/, hooks/, CLAUDE.md) is committed.
**/.claude/*
!**/.claude/settings.json
!**/.claude/skills/
!**/.claude/agents/
!**/.claude/commands/
!**/.claude/hooks/
!**/.claude/CLAUDE.md
**/.claude/settings.local.json
**/.claude/worktrees/

# Build artifacts
dist/
build/

# Ghost directories (macOS/iCloud restores these locally)
# Anchored to repo root only — portal subpaths like cardinal-portal/.../agents/ are tracked.
/agents/
/orchestrations/
/evals/

# Docker
pgdata/

# Node artifacts
node_modules/

# macOS Finder / iCloud sync-conflict duplicates
* 2.*
* 2
* 2/

# Lock files (LibreOffice etc.)
.~lock.*

# Large media files — research PDFs and demo videos stay out of git going forward
Multi-Agent Research/Inside_the_2027_Intelligence_Explosion.m4a
Multi-Agent Research/*.pdf
*.webm
demo_artifacts*/video_tmp/
