<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cardinal Element — {{ report.metadata.protocol_key | default('Protocol Analysis') }}</title>
<style>
  /* ── Reset & Base ─────────────────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --brand-red: #C22A3E;
    --brand-teal: #2AAC8A;
    --dark: #1a1a2e;
    --text: #374151;
    --text-muted: #6b7280;
    --bg-light: #f9fafb;
    --border: #e5e7eb;
  }

  @page {
    size: A4;
    margin: 30mm 25mm 25mm 25mm;
    @top-left { content: ""; border-top: 2px solid var(--brand-red); }
    @top-right { content: ""; border-top: 2px solid var(--brand-red); }
    @bottom-center {
      content: "Cardinal Element  |  Multi-Agent Protocol Analysis  |  Page " counter(page);
      font-size: 9px;
      color: var(--text-muted);
      font-family: system-ui, sans-serif;
    }
  }

  @page :first { margin-top: 40mm; @bottom-center { content: none; } }

  body {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 12px;
    line-height: 1.65;
    color: var(--dark);
    background: #fff;
  }

  /* ── Typography ───────────────────────────────────────────────── */
  h1, h2, h3 { font-family: Georgia, 'Times New Roman', serif; color: var(--brand-red); }
  h1 { font-size: 28px; margin-bottom: 8px; }
  h2 { font-size: 22px; margin: 28px 0 12px; border-bottom: 2px solid var(--brand-red); padding-bottom: 6px; }
  h3 { font-size: 16px; margin: 20px 0 8px; color: var(--dark); }
  h4 { font-size: 14px; margin: 16px 0 6px; color: var(--dark); font-family: system-ui, sans-serif; }
  p { margin: 8px 0; }
  strong { color: var(--dark); }
  hr { border: none; border-top: 1px solid var(--border); margin: 20px 0; }

  /* ── Cover Page ───────────────────────────────────────────────── */
  .cover {
    page-break-after: always;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 80vh;
    text-align: center;
  }

  .cover-brand {
    font-family: system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 4px;
    color: var(--brand-red);
    text-transform: uppercase;
    margin-bottom: 40px;
  }

  .cover-title {
    font-family: Georgia, serif;
    font-size: 32px;
    color: var(--brand-red);
    line-height: 1.3;
    margin-bottom: 8px;
  }

  .cover-subtitle {
    font-size: 16px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }

  .cover-divider {
    width: 120px;
    height: 2px;
    background: var(--brand-red);
    margin: 0 auto 24px;
  }

  .cover-date {
    font-size: 14px;
    color: var(--text);
    margin-bottom: 8px;
  }

  .cover-question {
    font-size: 13px;
    color: var(--text-muted);
    font-style: italic;
    max-width: 500px;
    margin: 0 auto 32px;
    line-height: 1.6;
  }

  .cover-stats {
    font-size: 13px;
    color: var(--brand-teal);
    font-weight: 600;
    margin-bottom: 16px;
  }

  .cover-agents {
    font-size: 11px;
    color: var(--text-muted);
    margin-bottom: 60px;
  }

  .cover-confidential {
    font-size: 10px;
    color: #9ca3af;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* ── Dashboard Cards ──────────────────────────────────────────── */
  .dashboard {
    display: flex;
    gap: 16px;
    margin: 16px 0 24px;
    flex-wrap: wrap;
  }

  .dash-card {
    flex: 1;
    min-width: 120px;
    text-align: center;
    padding: 16px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-light);
  }

  .dash-card .dash-value {
    font-size: 28px;
    font-weight: 700;
    color: var(--brand-red);
    line-height: 1;
  }

  .dash-card .dash-value.teal { color: var(--brand-teal); }
  .dash-card .dash-value.dark { color: var(--dark); }

  .dash-card .dash-label {
    font-size: 10px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-top: 6px;
  }

  /* ── Section Labels ───────────────────────────────────────────── */
  .section { margin-bottom: 24px; }

  .section-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 10px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 4px;
  }

  /* ── Executive Summary ─────────────────────────────────────────── */
  .exec-summary {
    border-left: 4px solid var(--brand-red);
    background: #fef2f2;
    border-radius: 0 6px 6px 0;
    padding: 16px 20px;
    font-size: 13px;
    line-height: 1.7;
  }

  .exec-summary h1, .exec-summary h2, .exec-summary h3 {
    font-size: 15px;
    margin: 12px 0 6px;
  }

  /* ── Confidence ───────────────────────────────────────────────── */
  .confidence-row { display: flex; align-items: center; gap: 12px; }
  .confidence-dots { display: flex; gap: 6px; }
  .dot { width: 14px; height: 14px; border-radius: 50%; display: inline-block; }
  .dot-green  { background: #22c55e; }
  .dot-yellow { background: #eab308; }
  .dot-red    { background: #ef4444; }
  .dot-gray   { background: #9ca3af; }
  .dot-empty  { background: #e5e7eb; border: 1px solid #d1d5db; }
  .confidence-label { font-size: 13px; font-weight: 600; color: var(--text); }
  .confidence-score { font-size: 11px; color: var(--text-muted); }

  /* ── Key Findings ─────────────────────────────────────────────── */
  .findings-list { list-style: none; padding: 0; }
  .findings-list li {
    padding: 6px 0 6px 18px;
    position: relative;
    border-bottom: 1px solid #f3f4f6;
    font-size: 12px;
    color: var(--text);
  }
  .findings-list li::before {
    content: '\25B8';
    position: absolute;
    left: 0;
    color: var(--brand-red);
    font-size: 10px;
    top: 8px;
  }

  /* ── Markdown Content (tables, lists, headings from MD) ────────── */
  .md-content { font-size: 12px; line-height: 1.7; color: var(--text); }
  .md-content h1 { font-size: 20px; page-break-after: avoid; }
  .md-content h2 { font-size: 17px; page-break-after: avoid; }
  .md-content h3 { font-size: 14px; page-break-after: avoid; }
  .md-content h4 { font-size: 13px; }

  .md-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0;
    font-size: 11px;
    page-break-inside: avoid;
  }
  .md-content th {
    background: var(--brand-red);
    color: #fff;
    padding: 8px 10px;
    text-align: left;
    font-weight: 600;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .md-content td {
    padding: 7px 10px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .md-content tr:nth-child(even) { background: var(--bg-light); }

  .md-content ul, .md-content ol { padding-left: 20px; margin: 8px 0; }
  .md-content li { margin: 4px 0; }
  .md-content blockquote {
    border-left: 3px solid var(--brand-red);
    padding: 8px 14px;
    margin: 12px 0;
    background: var(--bg-light);
    color: var(--text);
  }

  .md-content code {
    background: #f3f4f6;
    padding: 1px 5px;
    border-radius: 3px;
    font-size: 11px;
  }

  .md-content pre {
    background: #1f2937;
    color: #f9fafb;
    padding: 12px 16px;
    border-radius: 6px;
    font-size: 11px;
    overflow-x: auto;
    margin: 12px 0;
  }

  /* ── Agent Cards ──────────────────────────────────────────────── */
  .agent-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    margin-bottom: 16px;
    page-break-inside: avoid;
    overflow: hidden;
  }

  .agent-card-header {
    background: var(--bg-light);
    padding: 10px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
  }

  .agent-name { font-weight: 700; font-size: 13px; color: var(--dark); }

  .agent-badges { display: flex; gap: 8px; font-size: 10px; }
  .badge-model { background: #ede9fe; color: #5b21b6; padding: 2px 8px; border-radius: 100px; font-weight: 600; }
  .badge-cost { background: #d1fae5; color: #065f46; padding: 2px 8px; border-radius: 100px; font-weight: 600; }

  .agent-card-body { padding: 14px 16px; }

  /* ── Cost Footer ──────────────────────────────────────────────── */
  .cost-bar {
    background: var(--bg-light);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 20px;
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .cost-item { text-align: center; }
  .cost-value { font-size: 20px; font-weight: 700; color: var(--dark); }
  .cost-label { font-size: 9px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }

  /* ── Participant Tags ─────────────────────────────────────────── */
  .participant-tag {
    display: inline-block;
    background: #fef2f2;
    color: var(--brand-red);
    padding: 2px 10px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 600;
    margin: 2px 3px 2px 0;
    border: 1px solid #fecaca;
  }

  /* ── Metadata Footer ──────────────────────────────────────────── */
  .meta-footer {
    margin-top: 32px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 9px;
    color: #9ca3af;
    display: flex;
    justify-content: space-between;
  }

  /* ── Print ────────────────────────────────────────────────────── */
  @media print {
    body { padding: 0; }
    .agent-card { page-break-inside: avoid; }
    h2 { page-break-after: avoid; }
  }
</style>
</head>
<body>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- COVER PAGE                                                      -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="cover">
  <div class="cover-brand">Cardinal Element</div>

  <div class="cover-title">
    {% if report.metadata.protocol_key and 'pipeline' in (report.metadata.protocol_key | default('')) %}
      Strategic Pipeline Analysis
    {% else %}
      {{ report.metadata.protocol_key | default('Protocol Analysis') | replace('_', ' ') | title }}
    {% endif %}
  </div>
  <div class="cover-subtitle">Multi-Agent Protocol Analysis</div>

  <div class="cover-divider"></div>

  <div class="cover-date">{{ report.metadata.completed_at | default('') | truncate(10, true, '') }}</div>

  {% if report.metadata.question %}
  <div class="cover-question">
    {{ report.metadata.question | truncate(200, true, '...') }}
  </div>
  {% endif %}

  {% if report.participants %}
  <div class="cover-stats">
    {{ report.participants | length }} Agents
    {% if report.agent_contributions %} &bull; {{ report.agent_contributions | length }} Contributions{% endif %}
    {% if report.metadata.run_id %} &bull; Run #{{ report.metadata.run_id }}{% endif %}
  </div>

  <div class="cover-agents">
    Agents: {{ report.participants | join(', ') }}
  </div>
  {% endif %}

  <div class="cover-confidential">Confidential &mdash; Cardinal Element</div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- EXECUTIVE DASHBOARD                                             -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<h2>Executive Dashboard</h2>

<div class="dashboard">
  <div class="dash-card">
    <div class="dash-value dark">{{ report.participants | length | default(0) }}</div>
    <div class="dash-label">Agents Deployed</div>
  </div>
  <div class="dash-card">
    <div class="dash-value teal">{{ report.agent_contributions | length | default(0) }}</div>
    <div class="dash-label">Contributions</div>
  </div>
  <div class="dash-card">
    <div class="dash-value">{{ report.confidence_score | default(0) }}/5</div>
    <div class="dash-label">Confidence</div>
  </div>
  <div class="dash-card">
    <div class="dash-value dark">${{ "%.2f" | format(report.cost_summary.total_usd | default(0)) }}</div>
    <div class="dash-label">Total Cost</div>
  </div>
</div>

<!-- Key Findings -->
{% if report.key_findings %}
<div class="section">
  <ul class="findings-list">
    {% for finding in report.key_findings %}
    <li>{{ finding }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- EXECUTIVE SUMMARY                                               -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<h2>Executive Summary</h2>
<div class="exec-summary md-content">
  {{ report.executive_summary_html | safe }}
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- CONFIDENCE ASSESSMENT                                           -->
<!-- ═══════════════════════════════════════════════════════════════ -->
{% if report.confidence_score > 0 %}
<div class="section" style="margin-top: 20px;">
  <div class="section-label">Confidence Assessment</div>
  <div class="confidence-row">
    <div class="confidence-dots">
      {% set score = report.confidence_score %}
      {% for i in range(1, 6) %}
        {% if score >= 4 %}
          {% if i <= score %}<span class="dot dot-green"></span>{% else %}<span class="dot dot-empty"></span>{% endif %}
        {% elif score == 3 %}
          {% if i <= score %}<span class="dot dot-yellow"></span>{% else %}<span class="dot dot-empty"></span>{% endif %}
        {% else %}
          {% if i <= score %}<span class="dot dot-red"></span>{% else %}<span class="dot dot-empty"></span>{% endif %}
        {% endif %}
      {% endfor %}
    </div>
    <span class="confidence-label">{{ report.confidence_label }}</span>
    <span class="confidence-score">({{ score }}/5)</span>
  </div>
</div>
{% endif %}

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- FULL SYNTHESIS                                                  -->
<!-- ═══════════════════════════════════════════════════════════════ -->
{% if report.synthesis_html %}
<h2>Full Synthesis</h2>
<div class="md-content">
  {{ report.synthesis_html | safe }}
</div>
{% endif %}

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- AGENT CONTRIBUTIONS                                             -->
<!-- ═══════════════════════════════════════════════════════════════ -->
{% if report.agent_contributions %}
<h2>Agent Contributions</h2>

{% for contribution in report.agent_contributions %}
<div class="agent-card">
  <div class="agent-card-header">
    <div class="agent-name">{{ contribution.agent_name or contribution.agent_key }}</div>
    <div class="agent-badges">
      {% if contribution.model %}
      <span class="badge-model">{{ contribution.model | truncate(25, true, '...') }}</span>
      {% endif %}
      {% if contribution.cost_usd > 0 %}
      <span class="badge-cost">${{ "%.4f" | format(contribution.cost_usd) }}</span>
      {% endif %}
    </div>
  </div>
  <div class="agent-card-body md-content">
    {{ contribution.text_html | safe }}
  </div>
</div>
{% endfor %}
{% endif %}

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- COST SUMMARY                                                    -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<h2>Cost Summary</h2>
<div class="cost-bar">
  <div class="cost-item">
    <div class="cost-value">${{ "%.2f" | format(report.cost_summary.total_usd | default(0)) }}</div>
    <div class="cost-label">Total Cost</div>
  </div>
  <div class="cost-item">
    <div class="cost-value">{{ report.cost_summary.calls | default(0) }}</div>
    <div class="cost-label">API Calls</div>
  </div>
  {% if report.participants %}
  <div class="cost-item">
    <div class="cost-value">{{ report.participants | length }}</div>
    <div class="cost-label">Agents</div>
  </div>
  {% endif %}
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- FOOTER                                                          -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="meta-footer">
  <div>
    {% if report.metadata.trace_id %}Trace: {{ report.metadata.trace_id }}{% endif %}
  </div>
  <div>
    {% if report.metadata.started_at %}Started: {{ report.metadata.started_at | truncate(19, true, '') }}{% endif %}
    {% if report.metadata.completed_at %} &mdash; Completed: {{ report.metadata.completed_at | truncate(19, true, '') }}{% endif %}
  </div>
</div>

</body>
</html>
