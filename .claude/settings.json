{
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(pytest:*)",
      "Bash(mypy:*)",
      "Bash(python scripts/check-doc-drift.py:*)",
      "Bash(python3 scripts/check-doc-drift.py:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vite build:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-on-edit.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check-doc-drift.py\" --fs-only --quiet"
          }
        ]
      }
    ]
  }
}
