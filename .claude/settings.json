{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CE_REPO_ROOT": "${CLAUDE_PROJECT_DIR}",
    "CE_AGENT_BUILDER": "${CLAUDE_PROJECT_DIR}/CE - Agent Builder",
    "CE_ORCHESTRATION": "${CLAUDE_PROJECT_DIR}/CE - Multi-Agent Orchestration",
    "CE_EVALS": "${CLAUDE_PROJECT_DIR}/CE - Evals",
    "AGENT_MODE": "research"
  },
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(python -m protocols.*:*)",
      "Bash(python -m protocols:*)",
      "Bash(python -m pytest:*)",
      "Bash(python scripts/evaluate.py:*)",
      "Bash(python -m csuite:*)",
      "Bash(csuite:*)",
      "Bash(pip install -e .:*)",
      "Bash(pip install -r requirements.txt:*)",
      "Bash(python -m venv venv)",
      "Bash(source venv/bin/activate)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker exec ce-agents-postgres-1:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ]
  }
}
