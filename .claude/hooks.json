{
  "SessionStart": [
    {
      "matcher": "*",
      "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh" }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "*",
      "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-persist-orphans.sh" }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-check.sh" }
      ]
    }
  ]
}
